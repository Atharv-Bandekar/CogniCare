# =============================================================================
# CogniCare environment template.  Copy to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored — never commit real keys.
# =============================================================================

# ---- Supabase --------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
# IMPORTANT: the backend creates its Supabase client at IMPORT TIME. If either
# of these is blank, the API *and* the Celery worker crash the instant they
# start — not on first query. Fill these in before booting anything.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side secret; never expose to the browser

# ---- LLM (Groq is the default provider) ------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo         # transcribes inbound voice notes

# Optional Gemini fallback — only read when LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ---- Embeddings (Hugging Face Inference API, 384-dim MiniLM) ----------------
HUGGINGFACE_API_KEY=hf_your_token

# ---- Celery / Redis --------------------------------------------------------
# Inside docker-compose these are overridden to the `redis` service name, so
# the values here only matter if you run the worker directly on your host.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=Asia/Kolkata

# ---- Telegram Bot (production + recruiter demo channel) --------------------
# Create a bot with @BotFather and paste the token here. This channel is
# public by default (t.me/YourBotName) — anyone can start chatting, which is
# exactly what we need so a recruiter visiting the deployment can try the app
# without any pre-registration or WhatsApp trial limitations.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your-token-here

# Optional: Bot username (without @) for generating deep-links.
# If not set, defaults to "CogniCareDemoBot"
TELEGRAM_BOT_USERNAME=CogniCareDemoBot

# The PUBLIC https URL Telegram will POST updates to. Must match what you
# set via the webhook helper (see docs/TELEGRAM_SETUP.md). Example with a
# cloudflared tunnel:
#   TELEGRAM_WEBHOOK_URL=https://your-subdomain.trycloudflare.com/webhooks/telegram/inbound
# Production: https://your-render-url.onrender.com/webhooks/telegram/inbound
TELEGRAM_WEBHOOK_URL=https://YOUR-TUNNEL/webhooks/telegram/inboundELEGRAM_WEBHOOK_URL=https://YOUR-TUNNEL/webhooks/telegram/inbound

# Optional shared secret. If set, Telegram echoes it back in the
# X-Telegram-Bot-Api-Secret-Token header; the webhook validates it.
TELEGRAM_WEBHOOK_SECRET=your-random-secret-string

# Keep true in any real test. Set false ONLY to bypass secret validation for
# a first local smoke test where you haven't registered a secret_token yet.
TELEGRAM_VALIDATE_SECRET=true

# The caregiver_user_id (from auth.users) to assign to every auto-provisioned
# Telegram demo elder. elder_profiles.caregiver_user_id is NOT NULL (FK to
# auth.users), so this MUST be a real UUID from your Supabase project. Easiest:
# create a "demo" caregiver user in Supabase Auth, copy their UUID here.
TELEGRAM_DEMO_CAREGIVER_ID=your-caregiver-user-uuid-from-supabase-auth
