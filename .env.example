# =============================================================================
# CogniCare environment template.  Copy to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored — never commit real keys.
# =============================================================================

# ---- Supabase --------------------------------------------------------------
# Supabase dashboard -> Project Settings -> API.
# IMPORTANT: the backend creates its Supabase client at IMPORT TIME. If either
# of these is blank, the API *and* the Celery worker crash the instant they
# start — not on first query. Fill these in before booting anything.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side secret; never expose to the browser

# ---- LLM (Groq is the default provider) ------------------------------------
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo         # transcribes inbound voice notes

# Optional Gemini fallback — only read when LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# ---- Embeddings (Hugging Face Inference API, 384-dim MiniLM) ----------------
HUGGINGFACE_API_KEY=hf_your_token

# ---- Twilio WhatsApp -------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886        # Twilio sandbox number

# The PUBLIC https URL Twilio POSTs to. Signatures are validated against this
# exact string, so it must match what you set in the Twilio console — your
# tunnel URL plus the route:
#   https://your-subdomain.trycloudflare.com/webhooks/twilio/inbound
TWILIO_WEBHOOK_URL=https://YOUR-TUNNEL/webhooks/twilio/inbound

# Keep true in any real test. Set false ONLY to bypass signature checks when
# you have no matching public URL (forged requests are otherwise 403'd).
TWILIO_VALIDATE_SIGNATURE=true

# ---- Celery / Redis --------------------------------------------------------
# Inside docker-compose these are overridden to the `redis` service name, so
# the values here only matter if you run the worker directly on your host.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TIMEZONE=Asia/Kolkata
